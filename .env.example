# Supabase project connection
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Configure these as Supabase Edge Function secrets, never in a client app.
OSONSMS_BEARER_TOKEN=
OSONSMS_LOGIN=
OSONSMS_SENDER=

# Storage
STORAGE_MAX_FILE_SIZE_MB=10
UPLOAD_URL_EXPIRY_SECONDS=300

# App
NODE_ENV=development

# Push notifications (mock by default; safe with no real credentials)
PUSH_PROVIDER=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini AI (set this as a Supabase Edge Function secret in production)
GEMINI_API_KEY=

# OCR document scanning.  "google_vision" requires OCR_API_KEY; leave as
# "disabled" until that server-side secret has been provisioned.
OCR_PROVIDER=disabled
OCR_API_KEY=

# Barcode lookup. "open_food_facts" uses its public read API; keep disabled
# until the product decision has explicitly enabled the integration.
BARCODE_PROVIDER=disabled
